# Preserve the reviewed bytes of release assets checked by SHA-256.
/database/local/ra-catalog-v2/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/database/local/ra-operational/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/database/local/migrations/0002_ra_official_catalog.sql -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/public/data/cartography/ras-ide-2026-11-13.geojson -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/catalogos/ras-revisao-2026-11-13-v1/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/catalogos/ras-revisao-2026-11-13-v1/*.html -whitespace

# Preserve the installed local PCDF SQL attestation across Windows checkouts.
/database/local/pcdf-sandbox/direct.sql text eol=lf

# Preserve the SHA-256 pinned bytes of the institutional Supabase installer inputs.
/database/supabase/migrations/0009_importador_papeis_ambiente.sql -text
/database/supabase/migrations/0010_importador_objetos.sql -text
/database/supabase/migrations/0011_central_revisao_hospedada.sql -text
