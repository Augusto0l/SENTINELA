\set ON_ERROR_STOP on
BEGIN READ WRITE;
SET LOCAL search_path=pg_catalog,pg_temp;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='60s';
SET LOCAL sentinela.expected_uuid TO :'expected_uuid';
SET LOCAL sentinela.expected_system TO :'expected_system';
SET LOCAL sentinela.prova_restauracao TO :'prova_restauracao';

-- Installs the scoped capability. No approval is issued by this migration.
DO $preflight$
DECLARE
  v_usuario constant uuid := '29e7ec39-192b-4790-9180-3df950969bfc';
  v_identidade constant uuid := '00859431-29c9-499f-b64a-cbed32f03742';
  v_lote constant uuid := 'a88ac192-edef-4339-8381-106bbd1b391e';
  v_revisao constant text := 'e7de205ec3812ec78740c4041868f3982e3e964602c1b7a9c61f80d426e0ed71';
  plano jsonb;
BEGIN
  IF current_database()<>'sentinela_pcdf_local'
    OR inet_server_addr() IS DISTINCT FROM inet '127.0.0.1'
    OR inet_server_port() IS DISTINCT FROM 55484 OR pg_is_in_recovery()
    OR current_setting('server_version_num')<>'170011'
    OR current_setting('sentinela.sandbox_uuid',true) IS DISTINCT FROM current_setting('sentinela.expected_uuid')
    OR (SELECT system_identifier::text FROM pg_control_system()) IS DISTINCT FROM current_setting('sentinela.expected_system')
    OR current_setting('sentinela.prova_restauracao')<>'fa4ed26293a1e09e49b35963fedd58a37f0f72c29e2bade7386d4bdd96b08108'
  THEN RAISE EXCEPTION 'Destino e backup restaurado devem coincidir com a revisão'; END IF;

  PERFORM FROM sentinela_gestao_autorizacao.release r
  WHERE singleton AND aberta AND porta=inet_server_port() AND versao='local-import-management-0001'
    AND cluster_uuid::text=current_setting('sentinela.expected_uuid') AND system_id=current_setting('sentinela.expected_system')
  FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'Janela institucional fechada ou vinculada a outro destino'; END IF;

  PERFORM FROM sentinela_gestao_autorizacao.atores a
  JOIN sentinela.usuarios u ON u.id=a.usuario AND u.auth_user_id=a.identidade
  WHERE a.usuario=v_usuario AND a.identidade=v_identidade AND a.validade>clock_timestamp()
    AND a.conta=encode(sha256(convert_to(
      '["sentinela-supabase","https://hcmqsqfbrynpfjvmuqdb.supabase.co","00859431-29c9-499f-b64a-cbed32f03742"]','UTF8')),'hex')
    AND u.perfil='Administrador' AND u.ativo
  FOR SHARE OF a,u;
  IF NOT FOUND THEN RAISE EXCEPTION 'Vínculo institucional ausente ou expirado'; END IF;

  PERFORM pg_advisory_xact_lock(hashtextextended('sentinela-pcdf-local-v1',0));
  LOCK TABLE sentinela.extracoes_origem,sentinela.lotes_importacao,sentinela.execucoes_importacao,sentinela.linhas_origem,
    sentinela.linhas_staging,sentinela.pendencias_revisao,sentinela.historico_correcoes,sentinela.eventos_auditoria,
    sentinela_import_local.requests IN SHARE ROW EXCLUSIVE MODE;
  LOCK TABLE sentinela_gestao_autorizacao.exclusoes IN ACCESS EXCLUSIVE MODE;

  IF EXISTS (SELECT FROM sentinela_gestao_autorizacao.exclusoes e WHERE e.lote=v_lote)
    OR EXISTS (SELECT FROM sentinela_exclusao.comprovantes c WHERE c.lote=v_lote)
    OR EXISTS (SELECT FROM sentinela_exclusao.vinculos_inesperados())
    OR (SELECT count(*) FROM pg_class WHERE oid IN ('sentinela_gestao_autorizacao.exclusoes'::regclass,
      'sentinela_exclusao.comprovantes'::regclass) AND relrowsecurity AND relforcerowsecurity)<>2
    OR (SELECT count(*) FROM pg_class WHERE relnamespace='sentinela'::regnamespace
      AND relkind='r' AND relrowsecurity AND relforcerowsecurity)<>19
  THEN RAISE EXCEPTION 'Aprovação anterior, comprovante, FK divergente ou RLS inconsistente'; END IF;

  plano := sentinela_exclusao.plano(v_lote);
  IF sentinela_exclusao.revisao(plano) IS DISTINCT FROM v_revisao
    OR plano->'bloqueios' IS DISTINCT FROM jsonb_build_array(jsonb_build_object('tipo','lote_protegido','id',v_lote::text))
    OR NOT EXISTS (SELECT FROM sentinela.lotes_importacao l JOIN sentinela.extracoes_origem x ON x.id=l.extracao_id
      WHERE l.id=v_lote AND x.fonte='PCDF' AND l.competencia=DATE '2021-01-01' AND l.versao_contrato='1.0'
        AND l.nome_arquivo='pcdf_naturezas_2021-01.csv'
        AND l.sha256_arquivo='e202df3622fbd5f0b4ae53e7a8f435bce9ad58ff30a43a3c248ce2d369fd3770')
  THEN RAISE EXCEPTION 'Lote ou revisão atual diverge do plano apresentado'; END IF;

  IF EXISTS (SELECT FROM (VALUES
    ('sentinela_exclusao.plano(uuid)'::regprocedure,'0fd124d6e81d7a7a3fcd14eb9fe61df872160babbaf895294cc14ffbb14ac1c5'),
    ('sentinela_exclusao.previa(uuid,uuid,text)'::regprocedure,'8e07bf762db23419c1d25f834d191baafec5fa43245b18966da91d6f3809b252'),
    ('sentinela_exclusao.excluir(jsonb,text,uuid)'::regprocedure,'4e6070572c649d2294113144056f8df3eb09f4746ed58f7b6d1e3f5105deff81'),
    ('sentinela_gestao_autorizacao.lote_aprovado(uuid,uuid,text)'::regprocedure,'3e55a0bb5afdfa823441ccce58856e25bc1caaf29c00dbb7efb9710ab313f5f4'),
    ('sentinela_gestao_autorizacao.consumir(uuid,uuid,text,text)'::regprocedure,'4ac09864dca1d48b3ca0a506ddf0814e4b56258f87a1cb4833f7d912c42a7379')
  ) f(assinatura,sha) WHERE encode(sha256(convert_to(pg_get_functiondef(assinatura),'UTF8')),'hex') IS DISTINCT FROM sha)
  THEN RAISE EXCEPTION 'Definição de serviço diferente da base revisada'; END IF;
END $preflight$;

ALTER TABLE sentinela_gestao_autorizacao.exclusoes
  ADD COLUMN excecao_jan2021 boolean NOT NULL DEFAULT false,
  ADD CONSTRAINT exclusao_pontual_jan2021 CHECK (NOT excecao_jan2021 OR (
    lote='a88ac192-edef-4339-8381-106bbd1b391e' AND usuario='29e7ec39-192b-4790-9180-3df950969bfc'
    AND revisao='e7de205ec3812ec78740c4041868f3982e3e964602c1b7a9c61f80d426e0ed71'
    AND prova_restauracao='fa4ed26293a1e09e49b35963fedd58a37f0f72c29e2bade7386d4bdd96b08108'
  ));

ALTER TABLE sentinela_exclusao.comprovantes
  ADD COLUMN revisao_autorizada text,
  ADD COLUMN backup_restaurado text,
  ADD CONSTRAINT comprovante_pontual_jan2021 CHECK (
    (revisao_autorizada IS NULL AND backup_restaurado IS NULL) OR (
      lote='a88ac192-edef-4339-8381-106bbd1b391e' AND responsavel='29e7ec39-192b-4790-9180-3df950969bfc'
      AND revisao_autorizada IS NOT NULL AND backup_restaurado IS NOT NULL
      AND revisao_autorizada='e7de205ec3812ec78740c4041868f3982e3e964602c1b7a9c61f80d426e0ed71'
      AND backup_restaurado='fa4ed26293a1e09e49b35963fedd58a37f0f72c29e2bade7386d4bdd96b08108'
    )
  );

SET LOCAL ROLE sentinela_gestao_autoridade;
CREATE FUNCTION sentinela_gestao_autorizacao.emitir_jan2021(p_lote uuid,p_usuario uuid,p_conta text,p_revisao text,p_backup text)
RETURNS timestamptz LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $$
DECLARE v_validade timestamptz;
BEGIN
  PERFORM sentinela_gestao_autorizacao.exigir(p_usuario,p_conta);
  IF p_lote IS DISTINCT FROM 'a88ac192-edef-4339-8381-106bbd1b391e'::uuid
    OR p_usuario IS DISTINCT FROM '29e7ec39-192b-4790-9180-3df950969bfc'::uuid
    OR p_revisao IS DISTINCT FROM 'e7de205ec3812ec78740c4041868f3982e3e964602c1b7a9c61f80d426e0ed71'
    OR p_backup IS DISTINCT FROM 'fa4ed26293a1e09e49b35963fedd58a37f0f72c29e2bade7386d4bdd96b08108'
  THEN RAISE EXCEPTION USING ERRCODE='42501'; END IF;
  INSERT INTO sentinela_gestao_autorizacao.exclusoes(lote,usuario,revisao,aprovacao,prova_restauracao,validade,excecao_jan2021)
  SELECT p_lote,p_usuario,p_revisao,'Confirmação explícita do Administrador institucional na gestão de importações',
    p_backup,least(clock_timestamp()+interval '15 minutes',a.validade),true
  FROM sentinela_gestao_autorizacao.atores a WHERE a.usuario=p_usuario AND a.validade>clock_timestamp()
  ON CONFLICT(lote) DO UPDATE SET usuario=excluded.usuario,revisao=excluded.revisao,aprovacao=excluded.aprovacao,
    prova_restauracao=excluded.prova_restauracao,validade=excluded.validade,excecao_jan2021=true
  WHERE exclusoes.validade<=clock_timestamp()
  RETURNING validade INTO v_validade;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='40001'; END IF;
  RETURN v_validade;
END $$;

CREATE FUNCTION sentinela_gestao_autorizacao.validade_jan2021(p_lote uuid,p_usuario uuid,p_revisao text)
RETURNS timestamptz LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $$
  SELECT validade FROM sentinela_gestao_autorizacao.exclusoes
  WHERE session_user='sentinela_local_admin' AND lote=p_lote AND usuario=p_usuario AND revisao=p_revisao
    AND excecao_jan2021 AND validade>statement_timestamp()
$$;
REVOKE ALL ON FUNCTION sentinela_gestao_autorizacao.emitir_jan2021(uuid,uuid,text,text,text),
  sentinela_gestao_autorizacao.validade_jan2021(uuid,uuid,text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION sentinela_gestao_autorizacao.emitir_jan2021(uuid,uuid,text,text,text),
  sentinela_gestao_autorizacao.validade_jan2021(uuid,uuid,text) TO sentinela_exclusao_owner;
RESET ROLE;

SET LOCAL ROLE sentinela_exclusao_owner;
CREATE FUNCTION sentinela_exclusao.excecao_pontual_jan2021(plano jsonb) RETURNS boolean
LANGUAGE sql IMMUTABLE SET search_path=pg_catalog,pg_temp AS $$
  SELECT coalesce(plano->>'id'='a88ac192-edef-4339-8381-106bbd1b391e'
    AND plano->>'competencia'='2021-01' AND plano->>'contrato'='1.0'
    AND plano->'bloqueios'='[{"tipo":"lote_protegido","id":"a88ac192-edef-4339-8381-106bbd1b391e"}]'::jsonb
    AND sentinela_exclusao.revisao(plano)='e7de205ec3812ec78740c4041868f3982e3e964602c1b7a9c61f80d426e0ed71',false)
$$;
REVOKE ALL ON FUNCTION sentinela_exclusao.excecao_pontual_jan2021(jsonb) FROM PUBLIC;

CREATE FUNCTION sentinela_exclusao.autorizar_jan2021(alvo uuid,p_usuario uuid,p_conta text,p_revisao text,p_backup text)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $$
DECLARE plano jsonb; v_validade timestamptz;
BEGIN
  PERFORM sentinela_exclusao.exigir_ambiente();
  PERFORM sentinela_gestao_autorizacao.exigir(p_usuario,p_conta);
  PERFORM pg_advisory_xact_lock(hashtextextended('sentinela-pcdf-local-v1',0));
  plano:=sentinela_exclusao.plano(alvo);
  IF plano IS NULL THEN RAISE EXCEPTION USING ERRCODE='P0002'; END IF;
  IF sentinela_exclusao.revisao(plano) IS DISTINCT FROM p_revisao
    OR NOT sentinela_exclusao.excecao_pontual_jan2021(plano)
  THEN RAISE EXCEPTION USING ERRCODE='40001'; END IF;
  v_validade:=sentinela_gestao_autorizacao.emitir_jan2021(alvo,p_usuario,p_conta,p_revisao,p_backup);
  RETURN jsonb_build_object('id',alvo,'revisao',p_revisao,'validade',v_validade);
END $$;
REVOKE ALL ON FUNCTION sentinela_exclusao.autorizar_jan2021(uuid,uuid,text,text,text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION sentinela_exclusao.autorizar_jan2021(uuid,uuid,text,text,text) TO sentinela_local_admin;
RESET ROLE;

-- The installed definitions are pinned above. Change just these predicates, preserving the existing writer and transaction.
DO $patch$
DECLARE
  original text;
  atualizado text;
  alteracao record;
BEGIN
  FOR alteracao IN SELECT * FROM (VALUES
    ('sentinela_gestao_autorizacao.lote_aprovado(uuid,uuid,text)'::regprocedure,
      'validade>statement_timestamp()', 'validade>statement_timestamp() AND excecao_jan2021=(p_lote=''a88ac192-edef-4339-8381-106bbd1b391e'')'),
    ('sentinela_gestao_autorizacao.consumir(uuid,uuid,text,text)'::regprocedure,
      'validade>clock_timestamp()', 'validade>clock_timestamp() AND excecao_jan2021=(p_lote=''a88ac192-edef-4339-8381-106bbd1b391e'')'),
    ('sentinela_exclusao.previa(uuid,uuid,text)'::regprocedure,
      'AS d(tipo text,id text) GROUP BY tipo',
      'AS d(tipo text,id text) WHERE NOT (sentinela_exclusao.excecao_pontual_jan2021(plano) AND sentinela_gestao_autorizacao.lote_aprovado(alvo,p_usuario,sentinela_exclusao.revisao(plano))) GROUP BY tipo'),
    ('sentinela_exclusao.previa(uuid,uuid,text)'::regprocedure,
      '''autorizada'',sentinela_gestao_autorizacao.lote_aprovado(alvo,p_usuario,sentinela_exclusao.revisao(plano)),',
      $sql$'autorizada',sentinela_gestao_autorizacao.lote_aprovado(alvo,p_usuario,sentinela_exclusao.revisao(plano)),
      'dataImportacao',(SELECT criado_em FROM sentinela.lotes_importacao WHERE id=alvo),
      'dependencias',ARRAY(SELECT DISTINCT c.conrelid::regclass::text FROM pg_constraint c
        WHERE c.contype='f' AND c.confrelid IN (
          'sentinela.extracoes_origem'::regclass,'sentinela.lotes_importacao'::regclass,'sentinela.execucoes_importacao'::regclass,
          'sentinela.linhas_origem'::regclass,'sentinela.linhas_staging'::regclass,'sentinela.pendencias_revisao'::regclass,
          'sentinela.historico_correcoes'::regclass,'sentinela.eventos_auditoria'::regclass)
        ORDER BY c.conrelid::regclass::text),
      'excecao',CASE WHEN alvo='a88ac192-edef-4339-8381-106bbd1b391e' THEN jsonb_build_object(
        'elegivel',p_usuario='29e7ec39-192b-4790-9180-3df950969bfc' AND sentinela_exclusao.excecao_pontual_jan2021(plano),
        'validade',sentinela_gestao_autorizacao.validade_jan2021(alvo,p_usuario,sentinela_exclusao.revisao(plano))) END,$sql$),
    ('sentinela_exclusao.excluir(jsonb,text,uuid)'::regprocedure,
      'OR plano->''bloqueios''<>''[]''::jsonb',
      'OR (plano->''bloqueios''<>''[]''::jsonb AND NOT sentinela_exclusao.excecao_pontual_jan2021(plano))'),
    ('sentinela_exclusao.excluir(jsonb,text,uuid)'::regprocedure,
      ' PERFORM sentinela_gestao_autorizacao.consumir(alvo,p_usuario,conta,p->>''revisao'');',
      $sql$ IF alvo='a88ac192-edef-4339-8381-106bbd1b391e' AND (
        p->>'palavra' IS DISTINCT FROM 'EXCLUIR' OR
        p->>'provaBackup' IS DISTINCT FROM 'fa4ed26293a1e09e49b35963fedd58a37f0f72c29e2bade7386d4bdd96b08108')
      THEN RAISE EXCEPTION USING ERRCODE='22023'; END IF;
      PERFORM sentinela_gestao_autorizacao.consumir(alvo,p_usuario,conta,p->>'revisao');$sql$),
    ('sentinela_exclusao.excluir(jsonb,text,uuid)'::regprocedure,
      'INSERT INTO sentinela_exclusao.comprovantes(lote,responsavel,justificativa,quantidades)',
      'INSERT INTO sentinela_exclusao.comprovantes(lote,responsavel,justificativa,quantidades,revisao_autorizada,backup_restaurado)'),
    ('sentinela_exclusao.excluir(jsonb,text,uuid)'::regprocedure,
      'sentinela_exclusao.quantidades(plano)) RETURNING id INTO comprovante;',
      $sql$sentinela_exclusao.quantidades(plano),
        CASE WHEN sentinela_exclusao.excecao_pontual_jan2021(plano) THEN p->>'revisao' END,
        CASE WHEN sentinela_exclusao.excecao_pontual_jan2021(plano) THEN p->>'provaBackup' END)
      RETURNING id INTO comprovante;$sql$)
  ) p(assinatura,procurar,substituir)
  LOOP
    original := pg_get_functiondef(alteracao.assinatura);
    atualizado := replace(original,alteracao.procurar,alteracao.substituir);
    IF (length(original)-length(replace(original,alteracao.procurar,'')))<>length(alteracao.procurar)
      THEN RAISE EXCEPTION 'Trecho único esperado para %',alteracao.assinatura; END IF;
    EXECUTE atualizado;
  END LOOP;
END $patch$;

COMMIT;
\echo Capacidade pontual instalada. Nenhuma autorizacao de exclusao emitida.
