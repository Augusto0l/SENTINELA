-- SENTINELA · vínculo de um Operador institucional real ao PostgreSQL operacional 55484.
-- Use somente IDs comprovados pela própria pessoa autenticada: `usuario` (meu_acesso().usuario_id, perfil Operador)
-- e `identidade` (auth.getUser().id), o nome exibido e a referência da aprovação formal.
-- Por segurança, termina em ROLLBACK; passe -v confirmar=on somente após conferir o ensaio.
\set ON_ERROR_STOP on
\if :{?confirmar}
\else
\set confirmar off
\endif
BEGIN READ WRITE;
SET LOCAL search_path=pg_catalog,pg_temp;
SET LOCAL lock_timeout='5s';
SET LOCAL sentinela.expected_uuid TO :'expected_uuid';
SET LOCAL sentinela.expected_system TO :'expected_system';
SET LOCAL sentinela.usuario TO :'usuario';
SET LOCAL sentinela.identidade TO :'identidade';
SET LOCAL sentinela.nome TO :'nome';
SET LOCAL sentinela.aprovacao TO :'aprovacao';

DO $$
DECLARE
  usuario uuid := current_setting('sentinela.usuario')::uuid;
  identidade uuid := current_setting('sentinela.identidade')::uuid;
  nome text := btrim(current_setting('sentinela.nome'));
  aprovacao text := btrim(current_setting('sentinela.aprovacao'));
  cadastrado sentinela.usuarios%ROWTYPE;
BEGIN
  IF current_database() <> 'sentinela_pcdf_local' OR inet_server_addr() IS DISTINCT FROM inet '127.0.0.1'
    OR inet_server_port() IS DISTINCT FROM 55484 OR pg_is_in_recovery()
    OR current_setting('sentinela.sandbox_uuid',true) IS DISTINCT FROM current_setting('sentinela.expected_uuid')
    OR (SELECT system_identifier::text FROM pg_control_system()) IS DISTINCT FROM current_setting('sentinela.expected_system')
    OR NOT EXISTS (SELECT FROM sentinela.schema_migrations WHERE versao='local-manual-0004')
    OR NOT EXISTS (SELECT FROM pg_class WHERE oid='sentinela.usuarios'::regclass AND relrowsecurity AND relforcerowsecurity)
    OR length(nome) NOT BETWEEN 1 AND 240 OR length(aprovacao) NOT BETWEEN 5 AND 240
    -- The technical local rows are never reused for an institutional identity.
    OR usuario IN ('6ca6f86c-56da-4af8-8249-3291fb263c52','7d5a25df-d61a-43ae-9f09-7be430855aad','71000000-0000-4000-8000-000000000018')
    OR EXISTS (SELECT FROM sentinela.usuarios u WHERE u.auth_user_id=identidade AND u.id<>usuario)
  THEN RAISE EXCEPTION 'Destino atestado, identidade comprovada e aprovação são obrigatórios'; END IF;

  PERFORM pg_advisory_xact_lock(743204,22);
  SELECT * INTO cadastrado FROM sentinela.usuarios u WHERE u.id=usuario FOR UPDATE;
  IF FOUND THEN
    IF cadastrado.auth_user_id IS DISTINCT FROM identidade OR NOT cadastrado.ativo OR cadastrado.perfil <> 'Operador'
    THEN RAISE EXCEPTION 'Identidade ou estado institucional divergente'; END IF;
    RETURN;
  END IF;
  INSERT INTO sentinela.usuarios(id,auth_user_id,nome_exibicao,perfil,ativo)
    VALUES (usuario,identidade,nome,'Operador',true) RETURNING * INTO cadastrado;
  INSERT INTO sentinela.eventos_auditoria(ator_tipo,servico,acao,depois,justificativa)
    VALUES ('servico','provisionamento_controlado','provisionar_vinculo',to_jsonb(cadastrado),aprovacao);
END $$;

SELECT perfil||' '||ativo||' vinculado' FROM sentinela.usuarios WHERE id=current_setting('sentinela.usuario')::uuid;
\if :confirmar
COMMIT;
\else
ROLLBACK;
\echo Ensaio revertido; nada foi gravado.
\endif
