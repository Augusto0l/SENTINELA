BEGIN;
SET LOCAL lock_timeout='5s';
SELECT set_config('sentinela.map_uuid',:'cluster_uuid',true),
       set_config('sentinela.map_system',:'system_id',true) \gset
DO $guard$
BEGIN
 IF current_database()<>'sentinela_pcdf_local' OR inet_server_addr() IS DISTINCT FROM inet '127.0.0.1'
 OR inet_server_port() IS DISTINCT FROM 55484 OR pg_is_in_recovery()
 OR current_setting('sentinela.sandbox_uuid',true) IS DISTINCT FROM current_setting('sentinela.map_uuid')
 OR (SELECT system_identifier::text FROM pg_control_system()) IS DISTINCT FROM current_setting('sentinela.map_system')
 OR NOT EXISTS (SELECT FROM pg_class WHERE oid='sentinela.ocorrencias'::regclass AND relrowsecurity AND relforcerowsecurity)
 OR NOT EXISTS (SELECT FROM pg_class WHERE oid='sentinela_ocorrencias_analytics.ocorrencias'::regclass
    AND relowner='sentinela_ocorrencias_reader'::regrole AND 'security_barrier=true'=ANY(reloptions))
 OR to_regnamespace('sentinela_pcdf_geo') IS NOT NULL
 THEN RAISE EXCEPTION 'Destino, leitor ou projeção PCDF divergente'; END IF;
END $guard$;

-- A publicação homologada preencherá esta projeção após aprovação da evidência PCDF.
CREATE VIEW sentinela_ocorrencias_analytics.pontos_pcdf_publicados WITH (security_barrier=true) AS
 SELECT NULL::uuid AS id,NULL::float8 AS latitude,NULL::float8 AS longitude WHERE false;
CREATE VIEW sentinela_ocorrencias_analytics.pontos_confirmados WITH (security_barrier=true) AS
 SELECT o.id,extensions.ST_Y(o.geometria) AS latitude,extensions.ST_X(o.geometria) AS longitude
 FROM sentinela.ocorrencias o
 WHERE o.ativo AND o.consolidacao_status='consolidada' AND o.origem='manual' AND o.fonte='SENTINELA_MANUAL'
   AND o.localizacao_status='validada' AND o.referencia_espacial_confirmada='WGS84; IDE-DF-2026-11-13'
   AND nullif(btrim(o.regra_transformacao),'') IS NOT NULL
   AND o.geometria IS NOT NULL AND extensions.ST_SRID(o.geometria)=4326
   AND extensions.ST_Y(o.geometria)=o.latitude AND extensions.ST_X(o.geometria)=o.longitude
 UNION ALL
 SELECT id,latitude,longitude FROM sentinela_ocorrencias_analytics.pontos_pcdf_publicados;
ALTER VIEW sentinela_ocorrencias_analytics.pontos_pcdf_publicados OWNER TO sentinela_ocorrencias_reader;
ALTER VIEW sentinela_ocorrencias_analytics.pontos_confirmados OWNER TO sentinela_ocorrencias_reader;
GRANT SELECT ON sentinela_ocorrencias_analytics.pontos_confirmados
 TO sentinela_local_admin,sentinela_local_operator,sentinela_local_analyst;
COMMIT;
